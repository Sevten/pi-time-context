{
  "name": "@sevten/pi-time-context",
  "version": "0.1.0",
  "description": "Pi extension that gives conversations wall-clock context: sparse, deterministic timestamps and idle gaps for user messages and tool results.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sevten/pi-time-context"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "time-context",
    "timestamps",
    "wall-clock",
    "llm",
    "ai-agent",
    "context-management",
    "prompt-caching",
    "developer-tools",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "validate": "npm run check && npm test && npm run pack:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
