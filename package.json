{
  "name": "@sevten/pi-time-context",
  "version": "0.1.0",
  "description": "Deterministic, cache-stable wall-clock context for Pi conversations",
  "keywords": [
    "pi-package",
    "pi-extension",
    "time-context"
  ],
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "pack:check": "npm pack --dry-run",
    "validate": "npm run check && npm test && npm run pack:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.3",
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
